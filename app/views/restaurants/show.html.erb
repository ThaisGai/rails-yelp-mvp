<h1>Restaurant</h1>

<ul>
  <li>Name: <%= @restaurant.name %></li>
  <li>Address: <%= @restaurant.address %></li>
  <li>Phone: <%= @restaurant.phone_number %></li>
  <li>Category: <%= @restaurant.category %></li >
</ul>

<h2>Reviews</h2>

<ul>
  <% @restaurant.reviews.each do |review|%>
    <li><%= review.content %></li>
    <li><%= review.rating %></li>
  <% end %>
</ul>

<%= link_to "Add Review", new_restaurant_review_path(@restaurant)%>

<%= link_to "Back to list", restaurants_path, class: "btn btn-primary" %>

<%= link_to "Delete", restaurant_path(@restaurant),
  data: {turbo_method: :delete, turbo_confirm: "Are you sure?"},
  class: "btn btn-danger" %>

<%= link_to "Edit", edit_restaurant_path(@restaurant),
  class: "btn btn-primary" %>
