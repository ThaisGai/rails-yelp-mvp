<%= simple_form_for(@restaurant) do |f| %>
  <div class="container">
    <div class="form-inputs">
      <%= f.input :name %>
      <%= f.input :address %>
      <%= f.input :phone_number %>
      <%= f.select :category , ["Italian", "French", "Japanese", "Belgian", "chinese"]%>
    </div>
    <div class="form-actions">
      <%= f.button :submit, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
