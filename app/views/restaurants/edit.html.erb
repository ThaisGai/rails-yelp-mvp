<h1>Edit Restaurant</h1>

<%= simple_form_for @restaurant do |f|%>
<%= f.input :name %>
<%= f.input :address %>
<%= f.input :phone_number %>
<%= f.input :category %>
<% f.button :submit, "Updated", class:"btn btn-primary" %>
<% end %>

<%= link_to "Back to list", restaurant_path, class: "btn btn-secondary"%>
